root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organizzazione
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

# Stile
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: campi privati _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_rule.private_const_pascal.symbols = private_consts
dotnet_naming_rule.private_const_pascal.style = pascal
dotnet_naming_rule.private_const_pascal.severity = warning
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

# Analizzatori: soppressioni ereditate da Sharp-a-File che valgono anche per questa libreria
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates: i log della libreria sono pochi (avvisi di configurazione e retry)
dotnet_diagnostic.CA1873.severity = none   # argomenti di log costosi: idem
dotnet_diagnostic.CA1062.severity = none   # null-check argomenti pubblici: coperto da nullable reference types e da Guard.NotNull
dotnet_diagnostic.CA1303.severity = none   # stringhe localizzabili: la libreria non e' localizzata
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1308.severity = none   # ToLowerInvariant: la normalizzazione in minuscolo (nomi wire) e' voluta
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA2227.severity = none   # proprieta' di tipo collezione con set: i modelli di input usano get; set;

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # underscore nei nomi dei test
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.xUnit1051.severity = none   # token di cancellazione del test: non indispensabile nelle chiamate HTTP
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait: nei test no
dotnet_diagnostic.CA1515.severity = none   # tipi public in exe: servono a xunit

# Libreria pubblica: ConfigureAwait(false) ovunque, e IDE0005 (using inutili) si applica in build.
[src/**.cs]
dotnet_diagnostic.CA2007.severity = error
dotnet_diagnostic.IDE0005.severity = warning
