<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dipendenze di runtime con floor 8.0.x di proposito (floor piu' alti darebbero NU1605 a chi li fissa).
         Polyfill e pacchetti solo-netstandard2.0 si referenziano con Condition sul TFM. -->
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <!-- Test (stessi pin di Sharp-a-File). I Bcl.* servono anche ai test per la prova dell'asset netstandard2.0. -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
