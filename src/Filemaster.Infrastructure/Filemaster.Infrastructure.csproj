<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Filemaster.Infrastructure</AssemblyName>
    <RootNamespace>Filemaster.Infrastructure</RootNamespace>
    <PackageId>Filemaster.Infrastructure</PackageId>
    <Description>Filemaster.Infrastructure: adapter HTTP, trasporto (timeout e retry) e serializzazione JSON del client per l'API di Sharp-a-File.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filemaster.Application\Filemaster.Application.csproj" />
    <ProjectReference Include="..\Filemaster.Domain\Filemaster.Domain.csproj" />
  </ItemGroup>

  <!-- Filemaster (la composizione con IHttpClientFactory) usa la composizione interna su una sorgente di client: i quattro pacchetti
       si dipendono con versioni esatte [x.y.z], quindi un membro interno non puo' arrivare da una versione diversa. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Filemaster" />
    <InternalsVisibleTo Include="Filemaster.UnitTests" />
  </ItemGroup>
</Project>
