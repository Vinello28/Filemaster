<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Filemaster.Domain</AssemblyName>
    <RootNamespace>Filemaster.Domain</RootNamespace>
    <PackageId>Filemaster.Domain</PackageId>
    <Description>Filemaster.Domain: ID tipizzati, entita' ed eccezioni del client per l'API HTTP di Sharp-a-File.</Description>
  </PropertyGroup>

  <!-- Solo netstandard2.0: su net8.0/net10.0 System.Text.Json e i polyfill sono nel framework. La Condition e' igiene
       (con netstandard2.0 tra i TFM NU1510 non scatta comunque), non una necessita' misurata. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Filemaster.UnitTests" />
  </ItemGroup>
</Project>
